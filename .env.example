# Application Settings
APP_ENV=development
DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=generate_a_secure_random_key_min_32_characters_here
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (requires pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exam_prep_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Celery (Soporta Redis Cloud 30MB o Upstash; en Redis Cloud usar base de datos 0)
REDIS_URL=redis://default:<password>@<host>:<port>/0
CELERY_BROKER_URL=redis://default:<password>@<host>:<port>/0
CELERY_RESULT_BACKEND=redis://default:<password>@<host>:<port>/0
CACHE_TTL_DEFAULT=900

# Supabase Auth & Storage
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=documents

# LLM / AI Configuration (OpenRouter or OpenAI)
OPENROUTER_API_KEY=your_openrouter_or_openai_api_key

# Document Processing Limits
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_HOUR=20

# Optional Observability & Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
